# Obsidian Live Wallpaper — example environment (PLACEHOLDERS ONLY, never real values)
# Copy to .env and fill in before running. Optional: override browser binary paths.

# Path to a Chromium/Chrome executable (leave blank to auto-detect)
CHROME_PATH=

# Cache directory for Playwright/Puppeteer browsers
PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright
PUPPETEER_CACHE_DIR=.cache/puppeteer
